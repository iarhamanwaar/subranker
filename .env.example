# Upstream Stremio subtitle addon, WITHOUT the trailing /manifest.json.
#
# WARNING: many addon URLs embed credentials in their config segment (an
# AIOStreams manifest URL encodes your debrid API key). Keep this file out of
# version control — .env is gitignored, .env.example is not.
# Several may be given, comma-separated. They are queried in parallel and
# merged, which is worth doing because providers expose different metadata —
# one may report `moviehash` (an exact-file match) while another aggregates
# more sources but reports no hash.
UPSTREAM_BASE=https://example.com/stremio/<uuid>/<config>,https://another.example/<config>

# Port to bind on loopback. Put a reverse proxy in front for TLS.
PORT=7010

# Rewrite `lang` so each row is distinguishable on the device.
# Stremio only renders `id`, `url` and `lang`, so without this every row in a
# list of English subtitles reads identically. Disable if you rely on Stremio's
# auto-select-by-language.
RELABEL=true

# Remove clear mismatches (dub-timed tracks, wrong episode, dead links)
# instead of ranking them low.
DROP_MISMATCHES=true

# Download the top candidates to check they are alive and measure their timing.
VERIFY=true
VERIFY_LIMIT=15

# Per-file download timeout during verification, in milliseconds. Measured
# median is ~414ms and p90 ~897ms, so a generous ceiling only means one
# straggler holds up the whole response.
VERIFY_TIMEOUT_MS=2500

# Seconds to cache a computed response.
CACHE_TTL=3600

# Cap on returned subtitles PER LANGUAGE; 0 = no cap.
# Per language, not overall: ranking interleaves languages, so a global cap
# can return six rows none of which are in the language you read.
# Worth setting on clients that cannot label rows individually (the Android TV
# picker shows only the addon name per row), where a short, well-ranked list
# beats a long indistinguishable one.
MAX_RESULTS=0

# Diagnostic: return one row per candidate label format instead of real
# results, to discover which formats your client renders. Leave off normally.
PROBE_LABELS=false

# Public origin of this instance, e.g. https://subs.example.com.
# Required by AUTO_SHIFT, since corrected subtitles are served from this host.
PUBLIC_URL=

# Serve timing-corrected subtitles in place of drifting ones. Alignment already
# measures the offset and framerate ratio, so this applies them instead of
# leaving you to nudge Delay by hand.
AUTO_SHIFT=false

# Strip hearing-impaired annotations ([DOOR CREAKS], DOCTOR:). Turns an SDH
# track into an ordinary subtitle, which matters on titles where SDH is all
# there is. Off by default: it rewrites dialogue, so opt in deliberately.
REMOVE_HI=false

# Convert files written entirely in capitals to sentence case.
FIX_UPPERCASE=true

# Repair characters optical recognition confuses (l/I, rn/m).
FIX_OCR=true

# Merge cues that share screen time. Two lines drawn in the same place are
# unreadable; merging shows them stacked, and simultaneous speech gets the
# usual one-dash-per-speaker convention.
FIX_OVERLAPS=true

# Demote forced tracks (signs and foreign dialogue only). They look broken if
# picked by mistake: long silences, then one line.
DEMOTE_FORCED=true

ADDON_NAME=SubRanker
