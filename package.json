{
  "name": "subranker",
  "version": "0.1.1",
  "description": "A Stremio addon that ranks, verifies and relabels subtitles from any upstream subtitle addon, so the best-matching subtitle is always first.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ctrl/video-filename-parser": "^5.11.4",
    "anitomy-ng": "^1.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.32.1"
}
